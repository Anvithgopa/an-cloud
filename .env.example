# ==============================================================================
# ScorpioCloud — Personal Cloud Drive Configuration
# ==============================================================================

# Server Port (Bind to 127.0.0.1 behind Nginx in production)
PORT=3000
HOST=127.0.0.1
NODE_ENV=production

# Dedicated HDD Mount Root
# Must be /mnt/cloud in production on Raspberry Pi 4
STORAGE_ROOT=/mnt/cloud

# Require strict hardware mount check (verifies /mnt/cloud is a distinct mounted device and holds .hdd-identity)
# Set to true in Raspberry Pi production, false for local development/testing
REQUIRE_MOUNT_CHECK=true

# Expected HDD identity string inside /mnt/cloud/.hdd-identity (optional additional check)
HDD_IDENTITY_TOKEN=WD-SCORPIO-BLUE-250GB

# Session & Cookie Security
# Set SECURE_COOKIES=true when accessed over HTTPS (Nginx TLS / Tailscale HTTPS / Cloudflare Tunnel)
SESSION_SECRET=replace-with-high-entropy-64-char-hex-string
SECURE_COOKIES=false

# Default Quotas & Limits (can also be adjusted in Admin Settings UI)
MAX_UPLOAD_FILE_SIZE_BYTES=10737418240
DEFAULT_GUEST_QUOTA_BYTES=5368709120
MAX_CONCURRENT_GUEST_UPLOADS=3

# Background Indexer Interval (in minutes, 0 to disable automatic polling)
INDEXER_INTERVAL_MINUTES=30
